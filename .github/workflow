trigger:
  branches:
    include:
      - main
      - master

pool:
  vmImage: 'ubuntu-latest'

steps:
  - checkout: self

  - task: UsePythonVersion@0
    displayName: 'Ensure common tools (no-op for Java pipeline)'
    inputs:
      versionSpec: '3.x'

  - script: |
      echo "Using Java via Maven wrapper or system Maven"
    displayName: 'Info'

  - script: |
      if [ -f pom.xml ]; then
        mvn -B -DskipTests=false clean test
      else
        echo "No pom.xml found — adjust pipeline to compile with javac or add a build tool."
        exit 1
      fi
    displayName: 'Build & Run Unit Tests (Maven)'

  - script: |
      # Static analysis: run Checkstyle (will fail if rules violated)
      mvn org.apache.maven.plugins:maven-checkstyle-plugin:3.1.2:check
    displayName: 'Static analysis - Checkstyle'
    continueOnError: false

  - task: PublishTestResults@2
    inputs:
      testResultsFormat: 'JUnit'
      testResultsFiles: '**/target/surefire-reports/TEST-*.xml'
      failTaskOnFailedTests: true
    displayName: 'Publish JUnit Test Results'
